# ───── Server ─────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Comma-separated list of origins allowed to call this service
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ───── Database ─────
# sqlite | postgres
DB_DRIVER=sqlite
# For sqlite: a file path. For postgres: postgres://user:pass@host:5432/dbname
DB_URL=./data/users.db
# Auto-create / migrate schema on startup (turn OFF in production; use migrations instead)
DB_SYNCHRONIZE=true

# ───── Session store ─────
# memory | redis | db
SESSION_STORE=memory
REDIS_URL=redis://localhost:6379

# Session cookie
SESSION_COOKIE_NAME=uid_session
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_SECURE=false

# ───── Providers ─────
ENABLED_PROVIDERS=google

# Google
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Microsoft (future)
# MICROSOFT_TENANT=common
# MICROSOFT_CLIENT_ID=
